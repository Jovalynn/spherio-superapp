import crypto from "crypto";
import fs from "fs/promises";
import path from "path";
import { registerRioMindArtifact } from "@/lib/riomind/artifacts/registry";

export type CreateDocxArtifactInput = {
  ownerKey: string;
  title?: string;
  content?: unknown;
  sections?: unknown;
  columns?: unknown;
  rows?: unknown;
};

export type CreateDocxArtifactResult = {
  id: string;
  type: "docx";
  name: string;
  title: string;
  path: string;
  downloadUrl: string;
  paragraphCount: number;
  tableCount: number;
  sectionCount: number;
};

type DocxRow = Record<string, unknown>;

function safeFileTitle(value: unknown) {
  const raw = typeof value === "string" && value.trim() ? value.trim() : "nexus document";
  return raw
    .replace(/[\\/:*?"<>|]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 80) || "nexus document";
}

function normalizeOwnerKey(value: string) {
  return value.replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, 80) || "local_dev";
}

function text(value: unknown) {
  if (value === null || value === undefined) return "";
  return String(value).trim();
}

function normalizeRows(rows: unknown) {
  if (!Array.isArray(rows)) return [];

  return rows
    .map((row) => {
      if (row && typeof row === "object" && !Array.isArray(row)) {
        return { ...(row as DocxRow) };
      }

      if (Array.isArray(row)) {
        const output: DocxRow = {};
        row.forEach((value, index) => {
          output[`Column ${index + 1}`] = value ?? "";
        });
        return output;
      }

      return { Item: row ?? "" };
    })
    .filter((row) => Object.keys(row).length > 0);
}

function normalizeColumns(columns: unknown, rows: DocxRow[]) {
  if (Array.isArray(columns)) {
    const cleaned = columns.map((column) => text(column)).filter(Boolean);
    if (cleaned.length > 0) return Array.from(new Set(cleaned));
  }

  const discovered = new Set<string>();
  for (const row of rows) {
    for (const key of Object.keys(row)) discovered.add(key);
  }

  return Array.from(discovered);
}

function normalizeSections(sections: unknown, content: unknown) {
  if (Array.isArray(sections)) {
    const normalized = sections
      .map((section) => {
        if (typeof section === "string") {
          return { heading: "", body: section.trim() };
        }

        if (section && typeof section === "object" && !Array.isArray(section)) {
          const record = section as Record<string, unknown>;
          return {
            heading: text(record.heading ?? record.title ?? ""),
            body: text(record.body ?? record.content ?? record.text ?? ""),
          };
        }

        return { heading: "", body: "" };
      })
      .filter((section) => section.heading || section.body);

    if (normalized.length > 0) return normalized;
  }

  const body = text(content);
  if (!body) {
    return [{ heading: "Overview", body: "This document was generated by RioMind Nexus." }];
  }

  return splitMarkdownLikeContent(body);
}

function splitMarkdownLikeContent(content: string) {
  const lines = content.replace(/\r\n/g, "\n").split("\n");
  const sections: Array<{ heading: string; body: string }> = [];
  let heading = "Overview";
  let body: string[] = [];

  function flush() {
    const joined = body.join("\n").trim();
    if (heading || joined) sections.push({ heading, body: joined });
    body = [];
  }

  for (const line of lines) {
    const trimmed = line.trim();
    if (/^#{1,3}\s+/.test(trimmed)) {
      flush();
      heading = trimmed.replace(/^#{1,3}\s+/, "").trim() || "Section";
      continue;
    }
    body.push(line);
  }

  flush();
  return sections.filter((section) => section.heading || section.body);
}

function paragraphBlocks(value: string) {
  return value
    .replace(/\r\n/g, "\n")
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean);
}

export async function createDocxArtifact(
  input: CreateDocxArtifactInput
): Promise<CreateDocxArtifactResult> {
  const docxModule = await import("docx");
  const {
    AlignmentType,
    BorderStyle,
    Document,
    HeadingLevel,
    Packer,
    Paragraph,
    Table,
    TableCell,
    TableRow,
    TextRun,
    WidthType,
  } = docxModule as any;

  const title = safeFileTitle(input.title);
  const id = crypto.randomUUID();
  const shortId = id.slice(0, 8);
  const name = `${title}-${shortId}.docx`;

  const sections = normalizeSections(input.sections, input.content);
  const rows = normalizeRows(input.rows);
  const columns = normalizeColumns(input.columns, rows);

  let paragraphCount = 0;
  let tableCount = 0;

  const children: any[] = [
    new Paragraph({
      text: title,
      heading: HeadingLevel.TITLE,
      alignment: AlignmentType.CENTER,
      spacing: { after: 300 },
    }),
    new Paragraph({
      children: [
        new TextRun({
          text: "Generated by RioMind Nexus",
          italics: true,
          color: "475569",
        }),
      ],
      alignment: AlignmentType.CENTER,
      spacing: { after: 500 },
    }),
  ];

  paragraphCount += 2;

  for (const section of sections) {
    if (section.heading) {
      children.push(
        new Paragraph({
          text: section.heading,
          heading: HeadingLevel.HEADING_1,
          spacing: { before: 240, after: 160 },
        })
      );
      paragraphCount += 1;
    }

    for (const block of paragraphBlocks(section.body)) {
      const bullet = block.match(/^[-*]\s+(.+)$/);

      children.push(
        new Paragraph({
          text: bullet ? bullet[1] : block,
          bullet: bullet ? { level: 0 } : undefined,
          spacing: { after: 160 },
        })
      );
      paragraphCount += 1;
    }
  }

  if (rows.length > 0 && columns.length > 0) {
    children.push(
      new Paragraph({
        text: "Table",
        heading: HeadingLevel.HEADING_1,
        spacing: { before: 320, after: 160 },
      })
    );
    paragraphCount += 1;

    const tableRows = [
      new TableRow({
        tableHeader: true,
        children: columns.map(
          (column) =>
            new TableCell({
              shading: { fill: "111827" },
              children: [
                new Paragraph({
                  children: [
                    new TextRun({
                      text: column,
                      bold: true,
                      color: "FFFFFF",
                    }),
                  ],
                }),
              ],
            })
        ),
      }),
      ...rows.map(
        (row) =>
          new TableRow({
            children: columns.map(
              (column) =>
                new TableCell({
                  children: [
                    new Paragraph({
                      text: String((row as Record<string, unknown>)[column] ?? ""),
                    }),
                  ],
                })
            ),
          })
      ),
    ];

    children.push(
      new Table({
        width: { size: 100, type: WidthType.PERCENTAGE },
        rows: tableRows,
        borders: {
          top: { style: BorderStyle.SINGLE, size: 1, color: "CBD5E1" },
          bottom: { style: BorderStyle.SINGLE, size: 1, color: "CBD5E1" },
          left: { style: BorderStyle.SINGLE, size: 1, color: "CBD5E1" },
          right: { style: BorderStyle.SINGLE, size: 1, color: "CBD5E1" },
          insideHorizontal: { style: BorderStyle.SINGLE, size: 1, color: "E5E7EB" },
          insideVertical: { style: BorderStyle.SINGLE, size: 1, color: "E5E7EB" },
        },
      })
    );

    tableCount += 1;
  }

  const doc = new Document({
    creator: "RioMind Nexus",
    title,
    description: "Generated by RioMind Nexus",
    sections: [
      {
        properties: {
          page: {
            margin: {
              top: 1000,
              right: 900,
              bottom: 1000,
              left: 900,
            },
          },
        },
        children,
      },
    ],
  });

  const ownerKey = normalizeOwnerKey(input.ownerKey);
  const uploadRoot = process.env.RIOMIND_UPLOAD_DIR || "/app/.riomind_uploads";
  const artifactDir = path.join(uploadRoot, ownerKey, "artifacts");
  await fs.mkdir(artifactDir, { recursive: true });

  const filePath = path.join(artifactDir, name);
  const buffer = await Packer.toBuffer(doc);
  await fs.writeFile(filePath, buffer);

  const artifact: CreateDocxArtifactResult = {
    id,
    type: "docx",
    name,
    title,
    path: filePath,
    downloadUrl: `/api/riomind/artifacts/download?name=${encodeURIComponent(name)}`,
    paragraphCount,
    tableCount,
    sectionCount: sections.length,
  };

  await registerRioMindArtifact({
    ownerKey: input.ownerKey,
    artifact,
  });

  return artifact;
}
