import crypto from "crypto";
import fs from "fs/promises";
import nodeFs from "fs";
import path from "path";
import { registerRioMindArtifact } from "@/lib/riomind/artifacts/registry";

export type CreatePdfArtifactInput = {
  ownerKey: string;
  title?: string;
  content?: unknown;
  sections?: unknown;
  columns?: unknown;
  rows?: unknown;
};

export type CreatePdfArtifactResult = {
  id: string;
  type: "pdf";
  name: string;
  title: string;
  path: string;
  downloadUrl: string;
  pageCount: number;
  tableCount: number;
  sectionCount: number;
};

type PdfRow = Record<string, unknown>;

function safeFileTitle(value: unknown) {
  const raw = typeof value === "string" && value.trim() ? value.trim() : "nexus document";
  return raw
    .replace(/[\\/:*?"<>|]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 80) || "nexus document";
}

function normalizeOwnerKey(value: string) {
  return value.replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, 80) || "local_dev";
}

function text(value: unknown) {
  if (value === null || value === undefined) return "";
  return String(value).trim();
}

function firstExistingPath(paths: string[]) {
  return paths.find((candidate) => nodeFs.existsSync(candidate));
}

function registerPdfFonts(doc: any) {
  const regular = firstExistingPath([
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
  ]);

  const bold = firstExistingPath([
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
    regular || "",
  ]);

  const italic = firstExistingPath([
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Oblique.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationSans-Italic.ttf",
    regular || "",
  ]);

  if (!regular) {
    throw new Error("pdf_font_not_found");
  }

  doc.registerFont("NexusRegular", regular);
  doc.registerFont("NexusBold", bold || regular);
  doc.registerFont("NexusItalic", italic || regular);
}

function normalizeRows(rows: unknown) {
  if (!Array.isArray(rows)) return [];

  return rows
    .map((row) => {
      if (row && typeof row === "object" && !Array.isArray(row)) {
        return { ...(row as PdfRow) };
      }

      if (Array.isArray(row)) {
        const output: PdfRow = {};
        row.forEach((value, index) => {
          output[`Column ${index + 1}`] = value ?? "";
        });
        return output;
      }

      return { Item: row ?? "" };
    })
    .filter((row) => Object.keys(row).length > 0);
}

function normalizeColumns(columns: unknown, rows: PdfRow[]) {
  if (Array.isArray(columns)) {
    const cleaned = columns.map((column) => text(column)).filter(Boolean);
    if (cleaned.length > 0) return Array.from(new Set(cleaned));
  }

  const discovered = new Set<string>();
  for (const row of rows) {
    for (const key of Object.keys(row)) discovered.add(key);
  }

  return Array.from(discovered);
}

function normalizeSections(sections: unknown, content: unknown) {
  if (Array.isArray(sections)) {
    const normalized = sections
      .map((section) => {
        if (typeof section === "string") {
          return { heading: "", body: section.trim() };
        }

        if (section && typeof section === "object" && !Array.isArray(section)) {
          const record = section as Record<string, unknown>;
          return {
            heading: text(record.heading ?? record.title ?? ""),
            body: text(record.body ?? record.content ?? record.text ?? ""),
          };
        }

        return { heading: "", body: "" };
      })
      .filter((section) => section.heading || section.body);

    if (normalized.length > 0) return normalized;
  }

  const body = text(content);
  if (!body) {
    return [{ heading: "Overview", body: "This PDF was generated by RioMind Nexus." }];
  }

  return splitMarkdownLikeContent(body);
}

function splitMarkdownLikeContent(content: string) {
  const lines = content.replace(/\r\n/g, "\n").split("\n");
  const sections: Array<{ heading: string; body: string }> = [];
  let heading = "Overview";
  let body: string[] = [];

  function flush() {
    const joined = body.join("\n").trim();
    if (heading || joined) sections.push({ heading, body: joined });
    body = [];
  }

  for (const line of lines) {
    const trimmed = line.trim();

    if (/^#{1,3}\s+/.test(trimmed)) {
      flush();
      heading = trimmed.replace(/^#{1,3}\s+/, "").trim() || "Section";
      continue;
    }

    body.push(line);
  }

  flush();
  return sections.filter((section) => section.heading || section.body);
}

function paragraphBlocks(value: string) {
  return value
    .replace(/\r\n/g, "\n")
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean);
}

function addPageIfNeeded(doc: any, neededHeight = 80) {
  if (doc.y + neededHeight > doc.page.height - doc.page.margins.bottom) {
    doc.addPage();
  }
}

function drawTable(doc: any, columns: string[], rows: PdfRow[]) {
  if (columns.length === 0 || rows.length === 0) return;

  const pageWidth = doc.page.width - doc.page.margins.left - doc.page.margins.right;
  const usableColumns = columns.slice(0, 6);
  const columnWidth = pageWidth / usableColumns.length;
  const rowHeight = 24;
  const startX = doc.page.margins.left;

  addPageIfNeeded(doc, rowHeight * 2);

  let y = doc.y + 8;

  doc.rect(startX, y, pageWidth, rowHeight).fill("#111827");
  doc.fillColor("#FFFFFF").font("NexusBold").fontSize(8);

  usableColumns.forEach((column, index) => {
    doc.text(column, startX + index * columnWidth + 5, y + 8, {
      width: columnWidth - 10,
      ellipsis: true,
    });
  });

  y += rowHeight;

  doc.font("NexusRegular").fontSize(8).fillColor("#111827");

  rows.forEach((row, rowIndex) => {
    if (y + rowHeight > doc.page.height - doc.page.margins.bottom) {
      doc.addPage();
      y = doc.page.margins.top;
    }

    doc.rect(startX, y, pageWidth, rowHeight).fill(rowIndex % 2 === 0 ? "#F8FAFC" : "#FFFFFF");
    doc.fillColor("#111827");

    usableColumns.forEach((column, index) => {
      doc.text(String((row as Record<string, unknown>)[column] ?? ""), startX + index * columnWidth + 5, y + 7, {
        width: columnWidth - 10,
        ellipsis: true,
      });
    });

    doc.strokeColor("#E5E7EB").lineWidth(0.5).rect(startX, y, pageWidth, rowHeight).stroke();
    y += rowHeight;
  });

  doc.y = y + 16;
}

export async function createPdfArtifact(
  input: CreatePdfArtifactInput
): Promise<CreatePdfArtifactResult> {
  const pdfkitModule = await import("pdfkit");
  const PDFDocument = ((pdfkitModule as unknown as { default?: any }).default ?? pdfkitModule) as any;

  const title = safeFileTitle(input.title);
  const id = crypto.randomUUID();
  const shortId = id.slice(0, 8);
  const name = `${title}-${shortId}.pdf`;

  const sections = normalizeSections(input.sections, input.content);
  const rows = normalizeRows(input.rows);
  const columns = normalizeColumns(input.columns, rows);

  const ownerKey = normalizeOwnerKey(input.ownerKey);
  const uploadRoot = process.env.RIOMIND_UPLOAD_DIR || "/app/.riomind_uploads";
  const artifactDir = path.join(uploadRoot, ownerKey, "artifacts");
  await fs.mkdir(artifactDir, { recursive: true });

  const filePath = path.join(artifactDir, name);

  const doc = new PDFDocument({
    size: "A4",
    margin: 56,
    pdfVersion: "1.7",
    info: {
      Title: title,
      Author: "RioMind Nexus",
      Creator: "RioMind Nexus",
      Producer: "RioMind Nexus",
    },
  });

  registerPdfFonts(doc);

  const chunks: Buffer[] = [];
  doc.on("data", (chunk: Buffer) => chunks.push(chunk));

  const done = new Promise<Buffer>((resolve, reject) => {
    doc.on("end", () => resolve(Buffer.concat(chunks)));
    doc.on("error", reject);
  });

  doc.fillColor("#0F172A").font("NexusBold").fontSize(22).text(title, {
    align: "center",
  });

  doc.moveDown(0.4);
  doc.fillColor("#64748B").font("NexusItalic").fontSize(10).text("Generated by RioMind Nexus", {
    align: "center",
  });

  doc.moveDown(2);

  for (const section of sections) {
    addPageIfNeeded(doc, 90);

    if (section.heading) {
      doc.fillColor("#111827").font("NexusBold").fontSize(15).text(section.heading);
      doc.moveDown(0.5);
    }

    for (const block of paragraphBlocks(section.body)) {
      addPageIfNeeded(doc, 70);

      const bullet = block.match(/^[-*]\s+(.+)$/);
      if (bullet) {
        doc.fillColor("#111827").font("NexusRegular").fontSize(10).text(`• ${bullet[1]}`, {
          lineGap: 4,
        });
      } else {
        doc.fillColor("#111827").font("NexusRegular").fontSize(10).text(block, {
          lineGap: 4,
          align: "left",
        });
      }

      doc.moveDown(0.75);
    }
  }

  let tableCount = 0;

  if (rows.length > 0 && columns.length > 0) {
    addPageIfNeeded(doc, 120);
    doc.fillColor("#111827").font("NexusBold").fontSize(15).text("Table");
    doc.moveDown(0.5);
    drawTable(doc, columns, rows);
    tableCount = 1;
  }

  const pageCount = doc.bufferedPageRange().count || 1;

  doc.end();

  const buffer = await done;
  await fs.writeFile(filePath, buffer);

  const artifact: CreatePdfArtifactResult = {
    id,
    type: "pdf",
    name,
    title,
    path: filePath,
    downloadUrl: `/api/riomind/artifacts/download?name=${encodeURIComponent(name)}`,
    pageCount,
    tableCount,
    sectionCount: sections.length,
  };

  await registerRioMindArtifact({
    ownerKey: input.ownerKey,
    artifact,
  });

  return artifact;
}
